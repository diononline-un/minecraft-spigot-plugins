# Einstellungen des Sorters. Alle Werte sind optional; fehlende Werte gelten
# mit den hier gezeigten Voreinstellungen.
sorter:
  # Suchraum um den Heimatpunkt beim Ermitteln des Bereichs.
  search-radius: 48
  max-chests: 512
  max-height-difference: 64

  # Abstand, ab dem zwei Truhen als verbunden gelten. 0 heisst: nur direkt
  # aneinander gebaute Truhen. 1 überbrückt eine Lücke von einem Block.
  link-distance: 0

  # Wie viele Blöcke der Scan je Server-Tick abfragt. Höher = schneller, aber
  # mehr Last pro Tick.
  blocks-per-tick: 4096

  # Reichweite, innerhalb derer der Sorter ein Inventar anfassen darf.
  reach: 3.5

  # Zeitlimit und Wiederholungen für einen Anlauf zu einer Truhe.
  nav-timeout-ms: 4000
  max-nav-attempts: 2
  retry-backoff-ms: 1000

  # Wie lange eine unerreichbare Truhe ausgelassen wird.
  block-duration-ms: 120000

  # Höchstzahl gleichzeitig getragener Items (höchstens 54).
  carry-limit: 27

  # Wartezeit zwischen zwei Sortierläufen und zwischen zwei Bereichsermittlungen.
  sort-interval-ms: 30000
  rescan-interval-ms: 300000

  # Arbeit je Sorter und Durchlauf, sowie der Takt des Schedulers in Ticks.
  ops-per-tick: 8
  tick-period-ticks: 5

  # Obergrenze der gleichzeitig gehaltenen Chunk-Tickets.
  max-chunk-tickets: 256

  # Umfang des Transportprotokolls.
  log-capacity: 200

# Ausführliche Ausgabe im Serverlog.
debug: false
